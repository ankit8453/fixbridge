# Copy to apps/web/.env.local and adjust. Never commit the real .env.local.
# Vite only exposes vars prefixed VITE_ to client code (inlined into the
# bundle at build time, readable by anyone who views source) — anything that
# must stay server-side has no business in this file at all.

# ---------------------------------------------------------------------------
# Port collision with the API — read this before running both locally
# ---------------------------------------------------------------------------
#
# This app's dev server is fixed to :3000 (see vite.config.ts). apps/api ALSO
# defaults PORT to 3000 (apps/api/.env.example). Running `npm run start:dev`
# and `npm run dev:web` at the same time with both left at their defaults
# means the second process to bind :3000 fails outright.
#
# The fix is on the API side: give apps/api/.env a different PORT (e.g.
# PORT=3001) for local development, then point VITE_API_URL below at it.
VITE_API_URL=http://localhost:3001

# Razorpay checkout.js needs the key id client-side to open the payment sheet.
# This is a PUBLIC identifier, not a secret — it is meant to ship in the
# bundle. The matching key SECRET lives only in apps/api/.env and must NEVER
# appear here or in any VITE_-prefixed variable: everything under that prefix
# is inlined into client JavaScript at build time.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me

# The brand name is NOT decided (see src/brand/tokens.ts, the one file that
# has to change to swap it). This only overrides the default read from
# @fixbridge/shared's DEFAULT_APP_NAME for local development.
# VITE_APP_NAME=fixbridge
