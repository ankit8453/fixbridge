# Copy to apps/web/.env.local and adjust. Never commit the real .env.local.

# ---------------------------------------------------------------------------
# Port collision with the API — read this before running both locally
# ---------------------------------------------------------------------------
#
# This app's dev server is fixed to :3000 (Next's default, and what Vercel
# expects in production). apps/api ALSO defaults PORT to 3000
# (apps/api/.env.example). Running `npm run start:dev` and `npm run dev:web`
# at the same time with both left at their defaults means the second process
# to bind :3000 fails outright.
#
# The fix is on the API side, not here: give apps/api/.env a different PORT
# (e.g. PORT=3001) for local development, then point NEXT_PUBLIC_API_URL below
# at it. apps/web keeps :3000 because that is the one port a Vercel deploy
# does not let you choose, so it is not this file's problem to solve twice.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Razorpay checkout.js needs the key id client-side to open the payment sheet.
# This is a PUBLIC identifier, not a secret — it is meant to ship in the
# bundle. The matching RAZORPAY_KEY_SECRET lives only in apps/api/.env and
# must never appear here or in any NEXT_PUBLIC_* variable: anything prefixed
# NEXT_PUBLIC_ is inlined into client JavaScript at build time and readable by
# anyone who views source.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me

# The brand name is NOT decided (see src/brand/tokens.ts, the one file that
# has to change to swap it). This only overrides the default read from
# @fixbridge/shared's DEFAULT_APP_NAME for local development.
# NEXT_PUBLIC_APP_NAME=fixbridge

# The marketing surface's own base URL (components/marketing/seo.ts) — used
# to build absolute canonical/hreflang/OpenGraph URLs and sitemap.xml entries,
# none of which can be relative. Defaults to the local dev origin; set this to
# the real domain in the Vercel project once one exists, or every one of
# those URLs stays pointed at localhost in production.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Next's telemetry can crash on exit on some machines (it fails reading OS info
# and takes the process exit code with it, so a build that fully succeeded
# reports 255 and fails CI). If `next build` exits non-zero while printing a
# complete route table, this is why — set it and the build reports honestly.
# A product repo has no reason to report builds to a third party regardless.
NEXT_TELEMETRY_DISABLED=1
