# Copy to apps/api/.env and adjust. Never commit the real .env.
#
# The brand name is NOT decided. APP_NAME is the ONLY place a name lives —
# change it here and every log line, health payload and future response follows.
APP_NAME=fixbridge

# development | test | production
NODE_ENV=development
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://fixbridge:fixbridge@localhost:5432/fixbridge?schema=public
REDIS_URL=redis://localhost:6379

# How long graceful shutdown waits for in-flight work before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000
