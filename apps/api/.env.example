# Copy to apps/api/.env and adjust. Never commit the real .env.
#
# The brand name is NOT decided. APP_NAME is the ONLY place a name lives —
# change it here and every log line, health payload and future response follows.
APP_NAME=fixbridge

# development | test | production
NODE_ENV=development
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://fixbridge:fixbridge@localhost:5432/fixbridge?schema=public
REDIS_URL=redis://localhost:6379

# How long graceful shutdown waits for in-flight work before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000

# Number of proxy hops to trust for X-Forwarded-For. Keep 0 unless the API really
# sits behind a proxy — per-IP rate limiting is only as honest as this value.
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Auth (Phase 2)
# ---------------------------------------------------------------------------

# HS256 signing key for access tokens. Minimum 32 characters, no default.
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The config loader REFUSES to start in production with this placeholder value.
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars

# Access tokens stay short; refresh rotation covers longevity.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OTP lifetime and the aggressive limits that protect it.
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RATE_WINDOW_SECONDS=900
OTP_MAX_PER_PHONE=3
OTP_MAX_PER_IP=5

# Development convenience: this OTP always verifies, but ONLY for phone numbers
# starting with AUTH_FIXED_OTP_PHONE_PREFIX. The config schema rejects any
# environment that sets this with NODE_ENV=production — leave it unset there.
AUTH_FIXED_OTP=000000
AUTH_FIXED_OTP_PHONE_PREFIX=+9199999

# Admin/ops account created by `npm run seed`. Matches the fixed-OTP prefix above
# so you can actually sign in as admin in development.
SEED_ADMIN_PHONE=+919999900001

# ---------------------------------------------------------------------------
# Profiles (Phase 3)
# ---------------------------------------------------------------------------

# Completeness score a technician must reach to appear in search. The four
# booking-critical checklist items are weighted 21 each, so missing any one of
# them scores 79 and delists the profile.
PROVIDER_LISTING_THRESHOLD=80

# Saved addresses per customer.
MAX_ADDRESSES_PER_USER=5

# City used when a request omits cityId. Jabalpur = 1.
DEFAULT_CITY_ID=1

# ---------------------------------------------------------------------------
# Object storage for KYC documents (Phase 4)
# ---------------------------------------------------------------------------

# MinIO from docker-compose. In production point these at S3 or R2 and drop
# S3_ENDPOINT (real AWS needs no explicit endpoint).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=fixbridge
S3_SECRET_ACCESS_KEY=fixbridge-dev-secret
S3_BUCKET=fixbridge-kyc
# MinIO needs path-style addressing; real S3 prefers virtual-host style.
S3_FORCE_PATH_STYLE=true

# Signed URLs stay short-lived on purpose: least exposure of KYC material.
STORAGE_UPLOAD_URL_TTL_SECONDS=300
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=10485760

# Ops-only reviewer account created by `npm run seed`.
SEED_OPS_PHONE=+919999900002

# ---------------------------------------------------------------------------
# Search & ranking (Phase 5)
# ---------------------------------------------------------------------------

# /search is public, so the per-IP budget is the only thing guarding it.
SEARCH_RATE_LIMIT_PER_MINUTE=30
SEARCH_MAX_DISTANCE_KM=25
# Ranking runs in TypeScript to keep the scorer pure, so the candidate set is
# bounded. Matches beyond this are counted but not ranked (`truncated: true`).
SEARCH_MAX_CANDIDATES=200
# pg_trgm similarity floor for fuzzy synonym matching.
SEARCH_TRIGRAM_THRESHOLD=0.3
# Category provider counts are cached; staleness is accepted. See docs/search.md.
CATEGORY_COUNT_CACHE_TTL_SECONDS=300

# Result ordering is config, never code. Every weight is relative to the others.
RANK_WEIGHT_DISTANCE=50
RANK_WEIGHT_BADGE=15
RANK_WEIGHT_EXPERIENCE=10
RANK_WEIGHT_TRUST=10
RANK_WEIGHT_COMPLETENESS=5
RANK_WEIGHT_ACCEPTANCE=5
RANK_WEIGHT_PRICE=5
# Distance at which the distance score halves. Lower = stronger local bias.
RANK_DISTANCE_HALF_LIFE_KM=5

# ---------------------------------------------------------------------------
# Slots, bookings & the outbox (Phase 6)
# ---------------------------------------------------------------------------

# How far ahead slots are materialised, and how long each one is. A template
# window shorter than the increment produces no slot at all.
SLOT_HORIZON_DAYS=14
SLOT_INCREMENT_MINUTES=60
# How long a technician has to answer before the request expires and the hour
# goes back on sale.
BOOKING_REQUEST_TTL_MINUTES=15
# Snapshotted onto every booking at creation. Stored, never charged — Phase 8.
BOOKING_VISIT_FEE_PAISE=4900
# The physical handshake. Four digits because they are spoken aloud, in person;
# the attempt limit does the work that length does for a login OTP.
BOOKING_OTP_LENGTH=4
BOOKING_OTP_MAX_ATTEMPTS=5

# The dispatcher that delivers domain events. Delivery is at-least-once, so
# every consumer must be idempotent. See docs/bookings.md.
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_BASE_SECONDS=5
OUTBOX_BACKOFF_MAX_SECONDS=3600

# In-process background work, Redis-locked. Off in tests, which drive the jobs
# directly with an injected clock rather than waiting for a timer.
JOBS_ENABLED=true
BOOKING_EXPIRY_JOB_INTERVAL_MS=60000
# An interval, not a clock time: a service that restarts twice a day would never
# reach a 24-hour timer, and the job is idempotent so re-running is nearly free.
SLOT_HORIZON_JOB_INTERVAL_MS=21600000
