// Postgres 16 + PostGIS. Extensions are enabled by the first raw-SQL migration;
// geography/geometry columns arrive with the search phase via raw SQL + $queryRaw.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cities the marketplace operates in. `city_id` hangs off every city-scoped
/// table from day one so multi-city never needs a backfill migration.
model City {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  state     String   @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([name, state])
  @@index([isActive])
  @@map("cities")
}
