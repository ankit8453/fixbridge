// Postgres 16 + PostGIS. Extensions are enabled by the first raw-SQL migration.
//
// Prisma cannot model PostGIS types, so geography columns are declared with
// `Unsupported(...)`: they exist in the schema (and therefore in migrations and
// the generated SQL) but Prisma Client cannot read or write them. Every read and
// write of a point goes through raw SQL in a repository. See docs/geo-notes.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cities the marketplace operates in. `city_id` hangs off every city-scoped
/// table from day one so multi-city never needs a backfill migration.
model City {
  id                   Int      @id @default(autoincrement())
  name                 String   @db.VarChar(120)
  state                String   @db.VarChar(120)
  isActive             Boolean  @default(true) @map("is_active")
  /// Whether a technician needs an ops decision before they can be listed at
  /// all, on top of the automatic completeness and verification gates.
  ///
  /// Off for Jabalpur: the pilot cannot afford a human in the path of every
  /// signup, and the existing gates already keep an unverified profile out of
  /// search. It exists per-city because the first city where we do not know the
  /// trades personally is exactly where somebody will want to turn it on, and
  /// discovering then that it needs a migration is the wrong time.
  requireEntryApproval Boolean  @default(false) @map("require_entry_approval")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users            User[]
  categories       Category[]
  addresses        Address[]
  providerProfiles ProviderProfile[]
  feeConfigs       FeeConfig[]
  commissionConfig CommissionConfig[]

  coupons Coupon[]

  @@unique([name, state])
  @@index([isActive])
  @@map("cities")
}

/// Roles a user holds. Multiple per user — a technician is usually a customer too.
enum Role {
  customer
  technician
  ops
  admin

  @@map("role")
}

enum UserStatus {
  active
  blocked

  @@map("user_status")
}

/// Staff seniority, split on **reversibility, not seniority of job title**.
///
/// `subadmin` does the judgment work all day — verification decisions,
/// complaints, review moderation, suspensions, payout batch creation. `admin`
/// adds the irreversible, money-critical actions: refunds, marking a payout
/// paid, dues settlement, city config. A hired assistant should never hold a
/// credential that can move money out of the platform.
///
/// This replaces the old `ops` role from the `Role` enum, which existed when
/// staff were `User` rows authenticating by phone.
enum AdminRole {
  admin
  subadmin

  @@map("admin_role")
}

enum AdminStatus {
  active
  disabled

  @@map("admin_status")
}

/// The language a person reads.
///
/// Must stay in lockstep with `SUPPORTED_LOCALES` in `@fixbridge/shared`. It is a
/// column rather than a header because notifications are **asynchronous**: a
/// WhatsApp message composed by a background job has no request to read an
/// `Accept-Language` header from, and guessing wrong means a Jabalpur mistri gets
/// their suspension explained in English.
enum Language {
  hi
  en

  @@map("language")
}

/// Phone number is identity. There is no password column and never will be —
/// authentication is OTP-only.
model User {
  id                String     @id @default(uuid()) @db.Uuid
  /// E.164, always normalised to +91XXXXXXXXXX before it reaches the database.
  phone             String     @unique @db.VarChar(16)
  /// Collected during profile setup in Phase 3, not at signup.
  name              String?    @db.VarChar(120)
  status            UserStatus @default(active)
  /// Nullable FK kept from day one so multi-city never needs a backfill.
  defaultCityId     Int?       @map("default_city_id")
  /// Hindi by default, because Jabalpur is. Every asynchronous message renders
  /// in this language; the `Accept-Language` header only governs live requests.
  preferredLanguage Language   @default(hi) @map("preferred_language")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  defaultCity        City?            @relation(fields: [defaultCityId], references: [id], onDelete: SetNull)
  roles              UserRole[]
  refreshTokens      RefreshToken[]
  customerProfile    CustomerProfile?
  providerProfile    ProviderProfile?
  addresses          Address[]
  bookings           Booking[]        @relation("CustomerBookings")
  quotations         Quotation[]
  reviewsWritten     Review[]         @relation("ReviewsWritten")
  reviewsReceived    Review[]         @relation("ReviewsReceived")
  reviewReports      ReviewReport[]
  complaintsRaised   Complaint[]      @relation("ComplaintsRaised")
  complaintsAgainst  Complaint[]      @relation("ComplaintsAgainst")
  complaintsResolved Complaint[]      @relation("ComplaintsResolved")

  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  auditLogs              AuditLog[]
  couponRedemptions      CouponRedemption[]

  @@index([status])
  @@map("users")
}

/// Staff accounts — a table of their own, deliberately not `User` rows.
///
/// ## Why staff are not `User`s
///
/// `User.phone` is `NOT NULL` and unique: a phone *is* a customer's identity in
/// this market, and every notification path — WhatsApp, SMS, the OTP itself —
/// assumes it exists. Staff have no phone here at all, so modelling them as
/// "a user with a null phone" would mean relaxing that column to nullable for
/// everyone, and leaving a null-phone landmine in code paths that have been
/// correct since Phase 2. A separate table keeps the marketplace side provably
/// unchanged.
///
/// ## How staff sign in
///
/// Email + password, one factor, no OTP. This is a deliberate decision by the
/// product owner, not an oversight: there is no email transport wired up, and
/// they did not want a phone in this flow. What compensates for the single
/// factor is everything around it — scrypt hashing (`modules/auth/password.ts`),
/// rate limits per email *and* per IP consumed before the password is checked,
/// a constant-time-ish dummy hash comparison for unknown emails, and every
/// mutating action written to `audit_logs`.
///
/// ## There is no route that creates one of these
///
/// The single `admin` is bootstrapped from `ADMIN_EMAIL`/`ADMIN_PASSWORD` by
/// `prisma/bootstrap-admin.ts` — no HTTP endpoint, no signup form, no
/// self-service. Sub-admins are created from inside the admin dashboard by that
/// admin, which is why `createdById` exists: every sub-admin can be traced to
/// the admin who made it.
model AdminUser {
  id String @id @default(uuid()) @db.Uuid

  /// Lower-cased and trimmed before it reaches the database, so `Admin@x.com`
  /// and `admin@x.com` cannot become two accounts.
  email String @unique @db.VarChar(255)

  /// scrypt, in the self-describing `scrypt$N$r$p$salt$hash` format — the cost
  /// parameters travel with the hash, so they can be raised later without a
  /// migration or a forced password reset. Never nullable: unlike `User`, an
  /// account here that cannot authenticate has no reason to exist.
  passwordHash String @map("password_hash") @db.VarChar(400)

  name String @db.VarChar(120)

  role   AdminRole
  status AdminStatus @default(active)

  /// Which admin created this account. Null for the bootstrap admin, which was
  /// created by the deployment itself rather than by a person.
  ///
  /// `ON DELETE SET NULL` (not cascade): removing an admin must never silently
  /// delete the sub-admins they created, which would revoke access for people
  /// still doing the job.
  createdById   String?     @map("created_by_id") @db.Uuid
  createdBy     AdminUser?  @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins AdminUser[] @relation("AdminCreatedBy")

  /// Stamped on each successful sign-in. Useful for spotting a dormant account
  /// that should be disabled, and for an incident review.
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLogs      AuditLog[]
  refreshTokens  AdminRefreshToken[]
  couponsCreated Coupon[]

  @@index([status])
  @@map("admin_users")
}

/// Refresh tokens for staff sessions.
///
/// Separate from `RefreshToken` because that table's `user_id` carries a
/// foreign key to `users`, and staff are not `users` rows — inserting an
/// `admin_users` id there fails on the constraint. Sharing one table would
/// mean dropping that foreign key for everybody, which is exactly the kind of
/// weakening that lets an orphaned token outlive the account it belonged to.
///
/// Same rotation and revocation rules as the customer table, so nothing about
/// how sessions behave differs between the two.
model AdminRefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  adminId           String    @map("admin_id") @db.Uuid
  /// SHA-256 hex of the token. The token itself is never stored.
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  deviceId          String    @map("device_id") @db.VarChar(128)
  deviceInfo        String?   @map("device_info") @db.VarChar(512)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @unique @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  admin      AdminUser          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  replacedBy AdminRefreshToken? @relation("AdminTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   AdminRefreshToken? @relation("AdminTokenRotation")

  @@index([adminId, deviceId])
  @@index([expiresAt])
  @@map("admin_refresh_tokens")
}

/// Join table rather than an array column: it gives every grant its own row, so
/// Phase 11 can record who granted what and when without a migration.
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// Opaque refresh tokens, stored only as a SHA-256 hash and bound to a device.
/// Rotation forms a chain via `replacedByTokenId`; presenting an already-rotated
/// token is treated as theft and nukes every token for that (user, device).
model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// SHA-256 hex of the token. The token itself is never stored.
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  deviceId          String    @map("device_id") @db.VarChar(128)
  deviceInfo        String?   @map("device_info") @db.VarChar(512)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @unique @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId, deviceId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Service taxonomy
// ---------------------------------------------------------------------------

/// Two levels only: a cluster (`parent_id IS NULL`) and the services under it.
/// The depth limit is an application invariant — Postgres cannot express
/// "my parent must have no parent" as a CHECK constraint without a trigger.
///
/// `name_key` is an i18n key, never display text: the same row renders as
/// "Electrical" or "बिजली का काम" depending on Accept-Language.
model Category {
  id        Int      @id @default(autoincrement())
  cityId    Int      @map("city_id")
  parentId  Int?     @map("parent_id")
  nameKey   String   @map("name_key") @db.VarChar(120)
  slug      String   @db.VarChar(120)
  icon      String?  @db.VarChar(64)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city        City                @relation(fields: [cityId], references: [id], onDelete: Restrict)
  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]          @relation("CategoryTree")
  skills      ProviderSkill[]
  priceCards  ProviderPriceCard[]
  synonyms    HinglishSynonym[]
  bookings    Booking[]
  feeConfigs  FeeConfig[]
  commissions CommissionConfig[]
  coupons     Coupon[]

  @@unique([cityId, slug])
  @@index([cityId, isActive])
  @@index([parentId])
  @@map("categories")
}

/// How people actually ask for a service, mapped to what we call it.
///
/// A customer types "motor jal gayi" or "मोटर जल गई", not "motor rewinding".
/// Both scripts are stored as plain rows because this is a data problem, not a
/// code one — ops can add a phrase without a deploy.
///
/// `term` is stored already normalised (see `modules/search/normalize.ts`); the
/// query path normalises the same way, and a shared function guarantees they
/// cannot drift apart.
model HinglishSynonym {
  id         Int      @id @default(autoincrement())
  term       String   @db.VarChar(120)
  categoryId Int      @map("category_id")
  /// Lets a phrase point more strongly at one category than another.
  weight     Int      @default(1)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([term, categoryId])
  @@index([categoryId])
  @@map("hinglish_synonyms")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

/// Created lazily on the first profile write — auth already created the user row.
model CustomerProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(120)
  email       String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

enum AddressLabel {
  home
  shop
  other

  @@map("address_label")
}

/// Landmark-driven, because that is how a tier-2 address actually works:
/// "behind Gupta Kirana" locates a house that a street name never will.
///
/// `location` is NOT NULL and Prisma cannot write it, so every insert and update
/// of an address goes through raw SQL in the repository.
model Address {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  label       AddressLabel @default(other)
  /// Free text shown alongside the label, e.g. "Mummy's house".
  labelText   String?      @map("label_text") @db.VarChar(60)
  addressText String       @map("address_text") @db.VarChar(500)
  landmark    String?      @db.VarChar(200)
  cityId      Int          @map("city_id")
  /// WGS-84 degrees, stored as two plain columns rather than a PostGIS
  /// `geography(Point, 4326)` — see `core/geo-sql.ts` for why and for how to
  /// switch back. Prisma can read and write these directly, which is why this
  /// model no longer needs raw SQL for an ordinary insert.
  lat         Float        @db.DoublePrecision
  lng         Float        @db.DoublePrecision
  isDefault   Boolean      @default(false) @map("is_default")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Providers (technicians)
// ---------------------------------------------------------------------------

enum PriceType {
  fixed
  starting_from
  inspection_based

  @@map("price_type")
}

enum ProviderDocumentType {
  id_proof
  certificate
  photo
  other

  @@map("provider_document_type")
}

/// A document row is created when an upload URL is issued and only becomes
/// `uploaded` once the object is confirmed present in storage. A row stuck at
/// `awaiting_upload` means the client asked and never followed through.
enum ProviderDocumentStatus {
  awaiting_upload
  uploaded

  @@map("provider_document_status")
}

/// Keyed by `user_id`: a technician profile is an aspect of a user, not a
/// separate identity. The same person can hold a customer profile too.
///
/// `completeness_score` and `is_listed` are derived, recomputed on every write
/// that touches the profile or its children. Phase 5 search filters on
/// `is_listed` and must never see an incomplete profile.
model ProviderProfile {
  userId             String  @id @map("user_id") @db.Uuid
  displayName        String? @map("display_name") @db.VarChar(120)
  bio                String? @db.VarChar(1000)
  yearsExperience    Int?    @map("years_experience")
  cityId             Int     @map("city_id")
  /// WGS-84 degrees. Null until the technician sets their base location —
  /// which is why both are nullable and always checked together. See
  /// `core/geo-sql.ts`.
  baseLat            Float?  @map("base_lat") @db.DoublePrecision
  baseLng            Float?  @map("base_lng") @db.DoublePrecision
  serviceRadiusKm    Int     @default(5) @map("service_radius_km")
  completenessScore  Int     @default(0) @map("completeness_score")
  isListed           Boolean @default(false) @map("is_listed")
  /// True when ops keyed the data in on the technician's behalf.
  assistedOnboarding Boolean @default(false) @map("assisted_onboarding")

  /**
   * Suspension — a separate axis from verification, and reversible.
   * A suspended technician is hidden from search but keeps their badge: the
   * badge says who they are and the ladder that proved it, suspension says how
   * they have behaved lately. Conflating the two would mean a technician who
   * served a suspension had to re-upload their Aadhaar.
   * Expiry is checked **lazily** in the search predicate (`suspended_until <=
   * now()`) rather than by a job, so a suspension ends the moment it ends with
   * nothing to schedule and nothing to go wrong at 2am.
   */
  suspendedUntil   DateTime?         @map("suspended_until") @db.Timestamptz(3)
  suspendedAt      DateTime?         @map("suspended_at") @db.Timestamptz(3)
  suspensionReason SuspensionReason? @map("suspension_reason")

  /**
   * Ops let this technician onto the platform at all.
   * Only consulted where `cities.require_entry_approval` is on, which is nowhere
   * today. Null then simply means "never needed": the automatic gates —
   * completeness and verification — already decide who appears in search, and a
   * human in the path of every signup is a cost the pilot cannot carry.
   */
  entryApprovedAt   DateTime? @map("entry_approved_at") @db.Timestamptz(3)
  entryApprovedById String?   @map("entry_approved_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  city              City                           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  skills            ProviderSkill[]
  priceCards        ProviderPriceCard[]
  availability      ProviderAvailabilityTemplate[]
  documents         ProviderDocument[]
  verificationCases VerificationCase[]
  verification      ProviderVerificationSummary?
  slots             Slot[]
  bookings          Booking[]
  stats             ProviderStats?
  payouts           Payout[]
  trustSnapshots    TrustScoreSnapshot[]

  @@index([cityId, isListed])
  @@index([suspendedUntil])
  @@map("provider_profiles")
}

/// Why a technician is suspended. Recorded so ops and the technician are told
/// the same thing, and so Phase 11 can list suspensions by cause.
enum SuspensionReason {
  /// Trust score fell below the floor with enough jobs to mean it.
  auto_low_trust
  /// Repeated provider-side cancellations inside the rolling window.
  auto_repeat_cancellation
  /// A complaint was resolved as severe.
  complaint_severe
  /// A safety complaint was raised. Immediate, pending an ops decision.
  safety_pending_review
  /// Ops acting directly. Phase 11.
  ops_manual

  @@map("suspension_reason")
}

/// Leaf categories only — a technician does "motor rewinding", not "Electrical".
/// Enforced in the service, which is the only place that knows the tree shape.
model ProviderSkill {
  providerId     String   @map("provider_id") @db.Uuid
  categoryId     Int      @map("category_id")
  experienceNote String?  @map("experience_note") @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([providerId, categoryId])
  @@index([categoryId])
  @@map("provider_skills")
}

/// `amount_paise` is an integer number of paise and is null exactly when
/// `price_type` is `inspection_based`. A DB CHECK enforces that pairing.
model ProviderPriceCard {
  id          String    @id @default(uuid()) @db.Uuid
  providerId  String    @map("provider_id") @db.Uuid
  categoryId  Int       @map("category_id")
  title       String    @db.VarChar(120)
  priceType   PriceType @map("price_type")
  amountPaise Int?      @map("amount_paise")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([providerId, isActive])
  @@map("provider_price_cards")
}

/// A recurring weekly window, e.g. "Tuesday 18:00–22:00". Phase 6 expands these
/// into concrete bookable slots.
///
/// Times are minutes from midnight (0–1440) rather than Postgres `time`: they
/// compare and add with plain integer arithmetic, carry no timezone semantics,
/// and Prisma maps them to `number` instead of an epoch-dated `Date`.
///
/// v1 limitation: no overnight windows. `end_minute > start_minute` is enforced
/// by CHECK, so "22:00–02:00" must be entered as two rows on two days.
model ProviderAvailabilityTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday, matching JavaScript's `Date#getDay`.
  dayOfWeek   Int      @map("day_of_week") @db.SmallInt
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)
  slots    Slot[]

  @@index([providerId, dayOfWeek])
  @@map("provider_availability_templates")
}

/// Metadata about an object in private storage. The bytes never touch this
/// process: the client uploads to a pre-signed URL and then confirms, at which
/// point the API verifies the object exists and records its real size.
model ProviderDocument {
  id          String                 @id @default(uuid()) @db.Uuid
  providerId  String                 @map("provider_id") @db.Uuid
  docType     ProviderDocumentType   @map("doc_type")
  storageKey  String                 @unique @map("storage_key") @db.VarChar(300)
  status      ProviderDocumentStatus @default(awaiting_upload)
  contentType String                 @map("content_type") @db.VarChar(120)
  /// Declared at request time, replaced with the real size once confirmed.
  sizeBytes   Int                    @map("size_bytes")
  uploadedAt  DateTime?              @map("uploaded_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@index([providerId, docType])
  @@index([providerId, status])
  @@map("provider_documents")
}

// ---------------------------------------------------------------------------
// Verification
// ---------------------------------------------------------------------------

/// 0 identity · 1 background · 2 skill · 3 references. Levels are independent —
/// a provider may have level 0 and level 2 open at the same time.
enum VerificationStatus {
  submitted
  in_review
  needs_info
  passed
  failed

  @@map("verification_status")
}

enum VerificationEventType {
  submitted
  moved_to_review
  info_requested
  info_provided
  passed
  failed
  adapter_result_received

  @@map("verification_event_type")
}

enum VerificationActorType {
  provider
  ops
  system

  @@map("verification_actor_type")
}

/// `SILVER` and `GOLD` are trust-score bands computed in Phase 9. They exist in
/// the enum now so awarding them later needs no migration; only `VERIFIED` is
/// attainable today.
enum Badge {
  NONE
  VERIFIED
  SILVER
  GOLD

  @@map("badge")
}

/// One attempt at one level.
///
/// `status` is a cached projection of this case's events — the event log is the
/// truth. A failed case is closed forever; retrying opens a new case, so the
/// history of what was decided and when is never overwritten.
model VerificationCase {
  id         String             @id @default(uuid()) @db.Uuid
  providerId String             @map("provider_id") @db.Uuid
  level      Int                @db.SmallInt
  status     VerificationStatus @default(submitted)
  openedAt   DateTime           @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt   DateTime?          @map("closed_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider ProviderProfile     @relation(fields: [providerId], references: [userId], onDelete: Cascade)
  events   VerificationEvent[]

  @@index([providerId, level])
  @@index([status, openedAt])
  @@map("verification_cases")
}

/// The append-only core. Every transition, every ops decision, every document
/// view is a row here and nothing ever edits or removes one — a database trigger
/// refuses UPDATE and DELETE outright.
///
/// `payload` carries the evidence: which documents, the adapter's reference
/// token, masked identity fields. Never a raw identity number.
model VerificationEvent {
  id          String                @id @default(uuid()) @db.Uuid
  caseId      String                @map("case_id") @db.Uuid
  eventType   VerificationEventType @map("event_type")
  actorType   VerificationActorType @map("actor_type")
  /// Null for `system` events (adapters, automated transitions).
  actorUserId String?               @map("actor_user_id") @db.Uuid
  notes       String?               @db.VarChar(2000)
  payload     Json?                 @db.JsonB
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  case VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("verification_events")
}

/// Derived state, recomputed transactionally whenever a case passes or fails.
/// Kept as its own row rather than columns on the profile so the verification
/// module owns its own data.
model ProviderVerificationSummary {
  providerId   String    @id @map("provider_id") @db.Uuid
  /// Levels currently passed, e.g. `[0, 1, 3]`. The badge is derived from this.
  levelsPassed Int[]     @map("levels_passed")
  badge        Badge     @default(NONE)
  /// When the current badge was earned. Cleared when it is lost.
  badgeSince   DateTime? @map("badge_since") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@index([badge])
  @@map("provider_verification_summaries")
}

// ---------------------------------------------------------------------------
// Slots & bookings
// ---------------------------------------------------------------------------

enum SlotStatus {
  open
  held
  booked
  blocked

  @@map("slot_status")
}

/// A concrete, bookable hour in a technician's calendar.
///
/// The double-booking wall lives in the database, not in application code.
///
/// It used to be a GiST exclusion constraint over a derived `tstzrange`:
///
///   EXCLUDE USING gist (provider_id WITH =, time_range WITH &&)
///     WHERE (status IN ('held','booked'))
///
/// That needs `btree_gist`, which the current host cannot provide (see
/// `core/geo-sql.ts` and the initial migration). It is now a **partial unique
/// index** on `(provider_id, starts_at)` with the same `WHERE` clause.
///
/// Why that is equivalent *here*: slots are generated on a fixed grid from
/// availability templates (`slot-plan.ts` builds each from `dayStart + n *
/// incrementMinutes`), so two live slots for one provider can only collide by
/// sharing an identical `starts_at`. Partial overlap is not reachable from the
/// generator.
///
/// What it no longer catches: arbitrary, non-grid-aligned ranges. If a feature
/// ever inserts slots at caller-chosen times, this guarantee narrows and the
/// exclusion constraint has to come back — which needs `btree_gist`.
///
/// Either way it is still the database refusing the write, so a check-then-
/// insert race cannot get through. See docs/bookings.md.
model Slot {
  id               String     @id @default(uuid()) @db.Uuid
  providerId       String     @map("provider_id") @db.Uuid
  startsAt         DateTime   @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime   @map("ends_at") @db.Timestamptz(3)
  status           SlotStatus @default(open)
  /// Which availability template produced this slot, if any.
  sourceTemplateId String?    @map("source_template_id") @db.Uuid
  bookingId        String?    @unique @map("booking_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider       ProviderProfile               @relation(fields: [providerId], references: [userId], onDelete: Cascade)
  sourceTemplate ProviderAvailabilityTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  booking        Booking?                      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([providerId, startsAt])
  @@index([status, startsAt])
  @@map("slots")
}

/// The lifecycle a job moves through. `WORK_DONE` is terminal *for this phase* —
/// Phases 8 and 9 extend the machine with payment and review states, which is
/// why the transition table is data rather than a switch statement.
enum BookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  WORK_DONE
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_PROVIDER
  /// The technician came, quoted, and the customer chose not to go ahead.
  /// The visit happened, so the visit fee is payable and no work is billed.
  CLOSED_QUOTE_DECLINED

  @@map("booking_status")
}

enum BookingEventType {
  requested
  accepted
  rejected
  expired
  en_route
  arrived
  work_started
  work_done
  cancelled_by_customer
  cancelled_by_provider
  /// Recorded, but moves nothing — a failed handshake is evidence, not a state.
  otp_failed
  otp_locked
  /// Quotation lifecycle. The booking's timeline is the single narrative, so a
  /// quote being sent or decided lands here too. None of these move the booking;
  /// pricing is negotiated while the job stays IN_PROGRESS.
  quote_sent
  quote_withdrawn
  quote_approved
  quote_rejected
  /// The customer ended the job rather than accept a price. This one does move.
  work_declined
  /// Complaints. Recorded on the booking because its timeline is the single
  /// narrative of what happened — a dispute read six months later should not
  /// need two tables joined by hand. None of these move the booking.
  complaint_opened
  complaint_in_review
  complaint_resolved
  complaint_dismissed

  @@map("booking_event_type")
}

enum BookingActorType {
  customer
  provider
  system
  ops

  @@map("booking_actor_type")
}

model Booking {
  id              String  @id @default(uuid()) @db.Uuid
  customerId      String  @map("customer_id") @db.Uuid
  providerId      String  @map("provider_id") @db.Uuid
  categoryId      Int     @map("category_id")
  priceCardId     String? @map("price_card_id") @db.Uuid
  addressId       String? @map("address_id") @db.Uuid
  /**
   * What the address said at the moment of booking.
   * The customer may edit or delete the address afterwards; a technician
   * standing outside needs the address they were sent to, not the current one.
   */
  addressSnapshot Json    @map("address_snapshot") @db.JsonB

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  problemNote   String?       @map("problem_note") @db.VarChar(500)
  /// Snapshot of the visit fee at creation, resolved through `fee_config`.
  /// Whether it is actually charged is decided at the terminal transition.
  visitFeePaise Int           @map("visit_fee_paise")
  status        BookingStatus @default(REQUESTED)

  /// What the price card said **at the moment of booking**.
  ///
  /// Deliberately independent of `priceCardId`: a technician editing their rate
  /// mid-job must not change a bill, and a card deleted afterwards must not
  /// erase what was agreed. The snapshot outlives the card on purpose.
  priceCardAmountPaise Int?       @map("price_card_amount_paise")
  priceCardType        PriceType? @map("price_card_type")

  /// What the customer owes, frozen at the terminal transition.
  ///
  /// Phase 8 charges this number; it never recomputes one. A booking that ended
  /// before any money could be owed (rejected, expired, cancelled) leaves both
  /// columns null.
  payablePaise     Int?  @map("payable_paise")
  payableBreakdown Json? @map("payable_breakdown") @db.JsonB

  /// v1 has no reschedule: it is cancel + rebook, linked here for analytics.
  rescheduledFromBookingId String? @map("rescheduled_from_booking_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer         User               @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  provider         ProviderProfile    @relation(fields: [providerId], references: [userId], onDelete: Cascade)
  category         Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceCard        ProviderPriceCard? @relation(fields: [priceCardId], references: [id], onDelete: SetNull)
  events           BookingEvent[]
  slots            Slot[]
  quotations       Quotation[]
  payments         Payment[]
  journals         LedgerJournal[]
  reviews          Review[]
  complaints       Complaint[]
  couponRedemption CouponRedemption?

  @@index([customerId, createdAt])
  @@index([providerId, createdAt])
  @@index([status, createdAt])
  @@map("bookings")
}

/// Append-only, exactly like `verification_events`. A booking's whole history is
/// reconstructable from these rows and nothing may rewrite one.
model BookingEvent {
  id          String           @id @default(uuid()) @db.Uuid
  bookingId   String           @map("booking_id") @db.Uuid
  eventType   BookingEventType @map("event_type")
  actorType   BookingActorType @map("actor_type")
  actorUserId String?          @map("actor_user_id") @db.Uuid
  payload     Json?            @db.JsonB
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

// ---------------------------------------------------------------------------
// Quotations & pricing
// ---------------------------------------------------------------------------

/// What the technician charges for turning up, before any work is priced.
///
/// A table rather than a constant because the honest number differs by trade: a
/// motor rewinder arriving with tools and a meter has spent more getting there
/// than someone changing a tap washer. Rows are scoped city → category and
/// resolved most-specific-first; `effective_from` means a price change never
/// rewrites what an existing booking already snapshotted.
model FeeConfig {
  id String @id @default(uuid()) @db.Uuid

  cityId     Int  @map("city_id")
  /// Null means "the default for this city". A cluster id covers every service
  /// beneath it, so one row can price a whole trade.
  categoryId Int? @map("category_id")

  visitFeePaise Int      @map("visit_fee_paise")
  isActive      Boolean  @default(true) @map("is_active")
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city     City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([cityId, isActive, effectiveFrom])
  @@map("fee_config")
}

enum QuotationStatus {
  sent
  approved
  rejected
  /// Replaced by a newer version the provider sent.
  superseded
  /// Pulled back by the provider before the customer decided.
  withdrawn

  @@map("quotation_status")
}

enum QuotationItemKind {
  part
  labour_extra

  @@map("quotation_item_kind")
}

/// An itemised price, agreed in writing before the work proceeds.
///
/// This is the product's answer to the single biggest fear in tier-2 home
/// services: the number that appears after the job is finished. Nothing here is
/// ever edited — a revision is a **new version** that supersedes the old one,
/// because the customer saw v1 and v1 has to survive forever.
///
/// A partial unique index allows at most one `sent`-or-`approved` quotation per
/// booking, which is what makes the send/approve races safe at SQL level.
model Quotation {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  /// 1, 2, 3… per booking. Sequence, not identity.
  version   Int

  status QuotationStatus @default(sent)

  /**
   * What the customer already agreed to, copied from the booking's price
   * snapshot rather than accepted from the technician's app.
   *
   * Zero when the booking had no anchor (`inspection_based`, or no price card
   * at all) -- an estimate is not an agreement, so there is nothing to lock to.
   */
  agreedLabourPaise Int @default(0) @map("agreed_labour_paise")

  /**
   * Additional work found on site, which the customer has not agreed to yet.
   *
   * Separate from the agreed portion because they are different promises: one
   * is the price somebody chose this technician on, the other is a request.
   * Charging it requires `extraLabourReason`, enforced in
   * `modules/quotations/labour.ts` and again by a database CHECK.
   */
  extraLabourPaise Int @default(0) @map("extra_labour_paise")

  /**
   * Why the extra is being charged, in words the customer reads next to the
   * amount before they approve it. "₹200 extra" with no reason is how a
   * marketplace loses the trust it sells.
   */
  extraLabourReason String? @map("extra_labour_reason") @db.VarChar(300)

  /**
   * True when the extra exceeded the cap (the smaller of the agreed amount or
   * ₹5,000) and ops should look at it.
   *
   * Deliberately a flag rather than a refusal: blocking a genuinely large job
   * would push the transaction off-platform, where nobody is protected.
   */
  needsReview Boolean @default(false) @map("needs_review")

  /// `agreedLabourPaise + extraLabourPaise`. Kept so existing readers and the
  /// database's own total check keep working unchanged.
  labourPaise     Int @map("labour_paise")
  /// Denormalised sum of the items, so a total can be checked without a join.
  partsTotalPaise Int @map("parts_total_paise")
  totalPaise      Int @map("total_paise")

  note String? @db.VarChar(500)

  createdById  String    @map("created_by") @db.Uuid
  /// When the row stopped being live — decided, superseded or withdrawn.
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(3)
  /// The customer's reason for rejecting, when they gave one.
  decisionNote String?   @map("decision_note") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  items     QuotationItem[]

  @@unique([bookingId, version])
  @@index([bookingId, createdAt])
  /// The ops review queue: flagged quotes, oldest first.
  @@index([needsReview, createdAt])
  @@map("quotations")
}

/// One line of a quotation. Free text — a parts catalogue is a later problem.
model QuotationItem {
  id             String            @id @default(uuid()) @db.Uuid
  quotationId    String            @map("quotation_id") @db.Uuid
  kind           QuotationItemKind
  description    String            @db.VarChar(120)
  qty            Int
  unitPaise      Int               @map("unit_paise")
  /// `qty × unit_paise`, enforced by a CHECK so the arithmetic cannot drift.
  lineTotalPaise Int               @map("line_total_paise")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ---------------------------------------------------------------------------
// Reviews, complaints & trust
// ---------------------------------------------------------------------------

/// Who is rating whom.
///
/// The two directions are **not** symmetric in visibility, and that asymmetry is
/// a product decision, not an oversight — see the note on `Review`.
enum ReviewDirection {
  customer_to_provider
  provider_to_customer

  @@map("review_direction")
}

enum ReviewStatus {
  published
  /// Moderated away by ops. Excluded from every aggregate on recompute.
  hidden

  @@map("review_status")
}

/// A rating, tied to a job that was actually done and actually paid for.
///
/// ## Asymmetric visibility
///
/// **customer → provider** reviews are public. They power ranking, the profile
/// page and the trust score.
///
/// **provider → customer** reviews are internal in v1: ops can see them, they
/// feed future risk signals, and they are **never shown publicly** — not on a
/// profile, not in an API response, not to the customer they describe. A
/// technician needs somewhere to record "this address was not safe to enter"
/// without it becoming a public argument with a customer who can rate them back.
/// There is a test that fails if one ever leaks.
model Review {
  id        String          @id @default(uuid()) @db.Uuid
  bookingId String          @map("booking_id") @db.Uuid
  direction ReviewDirection

  authorUserId  String @map("author_user_id") @db.Uuid
  subjectUserId String @map("subject_user_id") @db.Uuid

  stars Int
  /// From a fixed list per direction — free-text tagging turns into a mess and
  /// cannot be aggregated. Validated in the service, not by the database.
  tags  String[]
  text  String?  @db.VarChar(500)

  status    ReviewStatus @default(published)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when ops moderate. The row is otherwise append-only.
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User           @relation("ReviewsWritten", fields: [authorUserId], references: [id], onDelete: Cascade)
  subject User           @relation("ReviewsReceived", fields: [subjectUserId], references: [id], onDelete: Cascade)
  reports ReviewReport[]

  @@unique([bookingId, direction])
  @@index([subjectUserId, status, createdAt])
  @@map("reviews")
}

/// Somebody flagged a review. Phase 11 gives ops a queue; this phase just
/// records the flag, because a report nobody wrote down is a report nobody acts
/// on.
model ReviewReport {
  id             String   @id @default(uuid()) @db.Uuid
  reviewId       String   @map("review_id") @db.Uuid
  reporterUserId String   @map("reporter_user_id") @db.Uuid
  reason         String   @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterUserId])
  @@index([reviewId])
  @@map("review_reports")
}

enum ComplaintCategory {
  overcharge
  no_show
  quality
  behavior
  cash_dispute
  /// Handled differently from every other category — see the note on `Complaint`.
  safety
  other

  @@map("complaint_category")
}

enum ComplaintStatus {
  open
  in_review
  resolved
  dismissed

  @@map("complaint_status")
}

/// How bad it turned out to be, decided by ops when they resolve it.
///
/// Only set on `resolved`. A dismissed complaint has no severity because it had
/// no substance, and counting it would punish a technician for being accused.
enum ComplaintSeverity {
  minor
  major
  severe

  @@map("complaint_severity")
}

/// Something went wrong on a job, raised by either party.
///
/// A `safety` complaint is the one category that does not wait: it suspends the
/// technician **synchronously**, before the response is written, pending an ops
/// decision. Every other signal in this system is eventually consistent through
/// the outbox, which is right for money and wrong for somebody being unsafe in a
/// stranger's home.
model Complaint {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  raisedByUserId String @map("raised_by_user_id") @db.Uuid
  againstUserId  String @map("against_user_id") @db.Uuid

  category    ComplaintCategory
  description String            @db.VarChar(1000)

  status               ComplaintStatus    @default(open)
  resolutionNote       String?            @map("resolution_note") @db.VarChar(1000)
  severityOnResolution ComplaintSeverity? @map("severity_on_resolution")
  resolvedByUserId     String?            @map("resolved_by_user_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedBy   User    @relation("ComplaintsRaised", fields: [raisedByUserId], references: [id], onDelete: Cascade)
  against    User    @relation("ComplaintsAgainst", fields: [againstUserId], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("ComplaintsResolved", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([againstUserId, status])
  @@index([status, createdAt])
  @@index([bookingId])
  @@map("complaints")
}

/// Every trust-score recomputation, kept forever.
///
/// The whole point is **explainability**. A technician asking "why is my score
/// 62?" gets a component-by-component answer out of `components`, and ops can
/// see what it was last week and what changed it. A score you cannot explain is
/// a score a technician cannot argue with, which in this market means a score
/// they will simply stop trusting.
///
/// Append-only. A recompute writes a new row; it never edits the last one.
model TrustScoreSnapshot {
  id         String @id @default(uuid()) @db.Uuid
  providerId String @map("provider_id") @db.Uuid

  /// 0–100. Null is not stored here — a snapshot only exists once there is
  /// something to score.
  score      Int
  /// Every input: raw value, normalised value, weight, contribution.
  components Json @db.JsonB

  badgeBandAfter     Badge   @map("badge_band_after")
  /// What caused this recompute, so a jump can be traced to an event.
  triggerTopic       String  @map("trigger_topic") @db.VarChar(120)
  triggerAggregateId String? @map("trigger_aggregate_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@map("trust_score_snapshots")
}

// ---------------------------------------------------------------------------
// Money — the ledger
// ---------------------------------------------------------------------------
//
// THE TWO LAWS (see docs/money.md):
//
//   1. Money exists ONLY as double-entry `ledger_entries`. There is no balance
//      column anywhere and there never will be — balances are views that sum
//      the entries. A number you can UPDATE is a number that can be wrong.
//   2. The gateway webhook is the only source of payment truth. A checkout
//      callback may optimistically show success; it never records it.

/// What a ledger account is for.
///
/// Five accounts carry the whole pilot. `provider_payable` and `provider_dues`
/// are the two sides of the same relationship — we owe them for online-paid
/// work, they owe us commission on cash they pocketed — and are kept apart so a
/// wallet can show both instead of one confusing net figure.
enum AccountType {
  /// Platform's money sitting at the gateway. An asset.
  gateway_cash
  /// What we owe a technician. A liability.
  provider_payable
  /// What a technician owes us, from commission on cash they collected. An asset.
  provider_dues
  /// Our cut. Revenue.
  platform_revenue
  /// Refunds owed but not yet settled. A liability.
  refunds_payable

  @@map("account_type")
}

enum AccountOwnerType {
  platform
  provider
  customer

  @@map("account_owner_type")
}

enum LedgerJournalType {
  payment_captured
  cash_collected
  refund
  payout
  dues_settled
  /// Ops correction. Phase 11 gives it an endpoint; the type exists now so a
  /// correction never has to masquerade as one of the others.
  adjustment

  @@map("ledger_journal_type")
}

enum LedgerDirection {
  debit
  credit

  @@map("ledger_direction")
}

/// One account in the double-entry system.
///
/// Rows are created lazily the first time money touches an owner, so a
/// technician who has never been paid has no account rather than a zero one.
model Account {
  id          String           @id @default(uuid()) @db.Uuid
  accountType AccountType      @map("account_type")
  ownerType   AccountOwnerType @map("owner_type")
  /// Null for platform accounts; a user id otherwise.
  ownerId     String?          @map("owner_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@map("accounts")
}

/// One balanced movement of money, with a reason.
///
/// Append-only, and — unlike bookings and KYC — with **no erasure escape
/// hatch**. A financial record is not personal data; the link to the person
/// (`booking_id`) is severed on erasure and the money stays, which is both the
/// legally correct answer and the only one an auditor would accept.
model LedgerJournal {
  id          String            @id @default(uuid()) @db.Uuid
  journalType LedgerJournalType @map("journal_type")
  /// Nulled rather than cascaded when a booking is erased.
  bookingId   String?           @map("booking_id") @db.Uuid
  paymentId   String?           @map("payment_id") @db.Uuid
  memo        String?           @db.VarChar(500)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payment Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  entries LedgerEntry[]

  @@index([journalType, createdAt])
  @@index([bookingId])
  @@map("ledger_journals")
}

/// One line of a journal. Σ debits = Σ credits per journal, enforced by a
/// deferred constraint trigger — not by the service that wrote it.
model LedgerEntry {
  id          String          @id @default(uuid()) @db.Uuid
  journalId   String          @map("journal_id") @db.Uuid
  accountId   String          @map("account_id") @db.Uuid
  direction   LedgerDirection
  amountPaise Int             @map("amount_paise")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  journal LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([journalId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Money — commission, payments, refunds, payouts
// ---------------------------------------------------------------------------

/// Our cut, in basis points, scoped exactly like `fee_config`.
///
/// Snapshotted onto the payment at collection, so changing the rate never
/// touches money that has already moved.
model CommissionConfig {
  id String @id @default(uuid()) @db.Uuid

  cityId     Int  @map("city_id")
  /// Null means "the default for this city". A cluster id covers its services.
  categoryId Int? @map("category_id")

  /// Basis points: 1200 = 12%.
  rateBps       Int      @map("rate_bps")
  isActive      Boolean  @default(true) @map("is_active")
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city     City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([cityId, isActive, effectiveFrom])
  @@map("commission_config")
}

enum PaymentPurpose {
  final_bill
  visit_fee_upfront

  @@map("payment_purpose")
}

/// How the money actually reached us.
///
/// A separate column rather than a `cash` member of the gateway enum: cash has
/// no gateway, no order id and no webhook, and modelling it as one would leave
/// three columns permanently null with nothing saying why.
enum PaymentMethod {
  online
  cash

  @@map("payment_method")
}

enum PaymentGatewayName {
  fake
  razorpay

  @@map("payment_gateway_name")
}

enum PaymentStatus {
  created
  captured
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

model Payment {
  id        String  @id @default(uuid()) @db.Uuid
  /// Nulled on erasure; the money record survives.
  bookingId String? @map("booking_id") @db.Uuid

  purpose               PaymentPurpose
  method                PaymentMethod
  /// The frozen payable this collects, **before any discount**. Never recomputed.
  ///
  /// Deliberately gross: commission is split on this figure, so the technician
  /// is paid on what the job was worth rather than on what the customer
  /// happened to pay after a coupon. The platform funds the discount out of its
  /// own commission -- see modules/coupons/discount.ts.
  amountPaise           Int            @map("amount_paise")
  /// What a coupon took off. Zero when none was applied. The gateway collected
  /// `amountPaise - discountPaise`.
  discountPaise         Int            @default(0) @map("discount_paise")
  /// Our rate at the moment of collection. Config changes never reach back.
  commissionBpsSnapshot Int            @map("commission_bps_snapshot")

  gateway          PaymentGatewayName? @map("gateway")
  gatewayOrderId   String?             @map("gateway_order_id") @db.VarChar(120)
  /// Set by the webhook, not by the browser.
  gatewayPaymentId String?             @map("gateway_payment_id") @db.VarChar(120)

  status PaymentStatus @default(created)

  /// The app said the customer got through checkout. Optimistic UX only — this
  /// never moves a single paisa.
  checkoutVerifiedAt DateTime? @map("checkout_verified_at") @db.Timestamptz(3)
  capturedAt         DateTime? @map("captured_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking  Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  refunds  Refund[]
  journals LedgerJournal[]

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("payments")
}

enum RefundStatus {
  created
  processed
  failed

  @@map("refund_status")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  paymentId       String       @map("payment_id") @db.Uuid
  amountPaise     Int          @map("amount_paise")
  gatewayRefundId String?      @map("gateway_refund_id") @db.VarChar(120)
  status          RefundStatus @default(created)
  reason          String?      @db.VarChar(300)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

/// Raw gateway deliveries, kept forever.
///
/// `gateway_event_id` is UNIQUE and that single constraint is the idempotency
/// wall: a gateway will deliver the same event more than once, and the second
/// insert simply fails. Processing happens off the outbox so a slow handler
/// never makes the gateway time out and retry harder.
model WebhookEvent {
  id             String   @id @default(uuid()) @db.Uuid
  gateway        String   @db.VarChar(40)
  gatewayEventId String   @unique @map("gateway_event_id") @db.VarChar(200)
  eventType      String   @map("event_type") @db.VarChar(120)
  payload        Json     @db.JsonB
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  /// Set when the event could not be applied. Parked, never dropped — ops read
  /// this in Phase 11.
  processingError String?   @map("processing_error") @db.VarChar(1000)

  @@index([processedAt, receivedAt])
  @@index([eventType])
  @@map("webhook_events")
}

enum PayoutBatchStatus {
  draft
  processing
  completed

  @@map("payout_batch_status")
}

enum PayoutStatus {
  pending
  paid
  failed

  @@map("payout_status")
}

/// One run of "pay everybody what they are owed".
model PayoutBatch {
  id          String            @id @default(uuid()) @db.Uuid
  status      PayoutBatchStatus @default(draft)
  createdById String?           @map("created_by") @db.Uuid
  /// Balances are snapshotted as at this instant.
  windowEnd   DateTime          @map("window_end") @db.Timestamptz(3)
  /// Must equal the sum of its payouts — asserted by a trigger.
  totalPaise  Int               @map("total_paise")
  payoutCount Int               @map("payout_count")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(3)

  payouts Payout[]

  @@index([status, createdAt])
  @@map("payout_batches")
}

model Payout {
  id          String       @id @default(uuid()) @db.Uuid
  batchId     String       @map("batch_id") @db.Uuid
  providerId  String       @map("provider_id") @db.Uuid
  amountPaise Int          @map("amount_paise")
  status      PayoutStatus @default(pending)
  /// The bank's reference, typed in by ops after a manual transfer. Pilot-grade
  /// on purpose: RazorpayX is an interface with no implementation behind it.
  utrRef      String?      @map("utr_ref") @db.VarChar(60)
  paidAt      DateTime?    @map("paid_at") @db.Timestamptz(3)
  failureNote String?      @map("failure_note") @db.VarChar(300)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch    PayoutBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@unique([batchId, providerId])
  @@index([providerId, createdAt])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Transactional outbox
// ---------------------------------------------------------------------------

/// Events written in the SAME transaction as the state change that caused them.
///
/// That is the whole point: a booking cannot be accepted without the
/// `booking.accepted` event also existing, and an event cannot exist for a
/// transition that rolled back. Delivery is at-least-once, so every consumer
/// must be idempotent. See docs/bookings.md.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  topic         String    @db.VarChar(120)
  aggregateType String    @map("aggregate_type") @db.VarChar(60)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json      @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error") @db.VarChar(2000)

  @@index([processedAt, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox")
}

/// Counters behind the acceptance rate that feeds search ranking.
///
/// Recomputed from `booking_events` whenever a relevant outbox event is
/// delivered — at pilot volume that is a trivial query, and it means the numbers
/// can never drift from the log they describe.
model ProviderStats {
  providerId               String   @id @map("provider_id") @db.Uuid
  acceptedCount            Int      @default(0) @map("accepted_count")
  rejectedCount            Int      @default(0) @map("rejected_count")
  expiredCount             Int      @default(0) @map("expired_count")
  cancelledByProviderCount Int      @default(0) @map("cancelled_by_provider_count")
  /// Null until there are enough decided requests to mean anything.
  acceptanceRate           Float?   @map("acceptance_rate")
  windowDays               Int      @default(30) @map("window_days")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /**
   * ---- Phase 9: reviews and trust ----
   */

  /// Mean stars over **published** customer→provider reviews, one decimal.
  /// Null until somebody has actually rated them.
  avgStars    Float? @map("avg_stars")
  reviewCount Int    @default(0) @map("review_count")
  /// `{ punctual: 4, polite: 2, … }`. Frequencies, for the profile page.
  tagCounts   Json?  @map("tag_counts") @db.JsonB

  /// Jobs that reached WORK_DONE **and** were paid for. The denominator badge
  /// bands and suspension rules are written against.
  settledJobsCount Int       @default(0) @map("settled_jobs_count")
  lastSettledAt    DateTime? @map("last_settled_at") @db.Timestamptz(3)

  /// Complaints resolved against them, by severity. Dismissed ones count for
  /// nothing — an accusation that did not stand up is not a record.
  complaintsMinorCount  Int @default(0) @map("complaints_minor_count")
  complaintsMajorCount  Int @default(0) @map("complaints_major_count")
  complaintsSevereCount Int @default(0) @map("complaints_severe_count")

  /// 0–100, or null until there is anything to score. Never 0 for "no data" —
  /// the ranking's neutral default is what an unknown technician deserves.
  trustScore        Int?      @map("trust_score")
  trustScoreUpdated DateTime? @map("trust_score_updated") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@map("provider_stats")
}

/// Every ops read of KYC material, recorded separately from the case timeline.
///
/// Kept out of `verification_events` on purpose: a read is not a state
/// transition, and mixing them would make the case history — the thing an
/// incident review reads — mostly noise.
model KycAccessLog {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  caseId      String?  @map("case_id") @db.Uuid
  /// Document ids whose signed URLs were handed out in this request.
  documentIds String[] @map("document_ids")
  action      String   @db.VarChar(60)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([providerId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("kyc_access_logs")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

/// Who did what, to whom, and what the decision actually said.
///
/// The backbone of the ops console. This product routes verification, complaints,
/// suspensions, refunds and payouts through **human judgment** — that was a
/// frozen decision, and it is the right one for a market that runs on trust. The
/// cost of it is that every one of those decisions is a person's opinion about
/// somebody else's livelihood, and an opinion nobody wrote down is one nobody can
/// be answerable for.
///
/// So: append-only, written **in the same transaction as the mutation it
/// describes**, and enumerated by a test that fails CI if a new admin mutation
/// arrives without one.
///
/// ## Why `action` is a string and not a Postgres enum
///
/// Every new ops capability would otherwise need a migration to name itself, and
/// a migration is exactly the wrong amount of friction for adding an audit
/// action — the pressure would be to reuse a near-enough existing one, which is
/// how audit logs stop being readable. The closed set lives in TypeScript

/// A discount the platform funds out of its own commission.
///
/// ## Platform-funded, never partner-funded
///
/// The technician is always paid on the PRE-discount amount. The difference
/// comes out of the platform's commission, which is why `maxDiscountPaise` is
/// required rather than optional: a percentage with no ceiling on a large job
/// is an unbounded loss.
///
/// ## Online payment only
///
/// Enforced in `modules/coupons/discount.ts`, not just hidden in the UI. On a
/// cash job the technician collects the discounted amount in hand while
/// commission is computed on the full price -- so the discount would come out
/// of the technician's pocket rather than the platform's. That is not a
/// discount, it is a pay cut imposed on somebody else.
model Coupon {
  id   String @id @default(uuid()) @db.Uuid
  /// Stored uppercase so `SAVE20` and `save20` cannot become two coupons.
  code String @unique @db.VarChar(32)

  description String @db.VarChar(200)

  discountType CouponDiscountType @map("discount_type")
  /// Percent (1-100) for `percent`, paise for `flat`.
  value        Int

  /// The ceiling on what any single redemption may take off. Required.
  maxDiscountPaise Int @map("max_discount_paise")
  /// Below this order value the coupon does not apply.
  minOrderPaise    Int @default(0) @map("min_order_paise")

  validFrom  DateTime @map("valid_from") @db.Timestamptz(3)
  validUntil DateTime @map("valid_until") @db.Timestamptz(3)

  /// Null means unlimited overall; the per-customer limit still applies.
  totalUsageLimit  Int? @map("total_usage_limit")
  perCustomerLimit Int  @default(1) @map("per_customer_limit")

  status CouponStatus @default(active)

  /// Optional scoping. Null on either means "everywhere" / "every category".
  cityId     Int? @map("city_id")
  categoryId Int? @map("category_id")

  createdByAdminId String? @map("created_by_admin_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city        City?              @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   AdminUser?         @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]

  @@index([status, validUntil])
  @@map("coupons")
}

/// One row per coupon actually applied to a booking.
///
/// This table, not a counter on `Coupon`, is what enforces the usage limits --
/// a counter can drift, rows cannot. The unique on `bookingId` is what makes
/// "one coupon per booking" a database guarantee rather than a service check.
model CouponRedemption {
  id         String @id @default(uuid()) @db.Uuid
  couponId   String @map("coupon_id") @db.Uuid
  /// Unique: a booking may carry at most one coupon.
  bookingId  String @unique @map("booking_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  /// What was actually taken off, after the cap was applied. Not recomputable
  /// later: the coupon's own terms may have changed since.
  discountPaise Int @map("discount_paise")

  redeemedAt DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(3)

  coupon   Coupon  @relation(fields: [couponId], references: [id], onDelete: Restrict)
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([couponId, redeemedAt])
  @@index([customerId, couponId])
  @@map("coupon_redemptions")
}

enum CouponDiscountType {
  percent
  flat

  @@map("coupon_discount_type")
}

enum CouponStatus {
  active
  paused
  expired

  @@map("coupon_status")
}

/// (`AUDIT_ACTIONS`), where it is still exhaustive and still typo-proof.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Nullable, and `ON DELETE SET NULL`.
  ///
  /// Same reasoning as the ledger: DPDP erasure must be able to remove a person
  /// without erasing the record that a decision was made. The action survives;
  /// the link to the human does not.
  actorUserId String? @map("actor_user_id") @db.Uuid

  /// The staff actor, when the action was taken by an `AdminUser`.
  ///
  /// Two actor columns rather than one polymorphic id because both kinds
  /// genuinely act: staff decide verification cases and move money, while
  /// customers and technicians generate audited events of their own (a booking
  /// cancellation is written by `bookings/repository.ts` with an
  /// `actorUserId`). A single column would have to give up its foreign key to
  /// hold both, and an audit trail whose actor can point at a deleted row is
  /// not evidence.
  ///
  /// A database CHECK constraint enforces that at most one of the two is set —
  /// see the migration. Also `ON DELETE SET NULL`, for the same DPDP reason as
  /// `actorUserId`: the decision survives the erasure of the person.
  actorAdminId String? @map("actor_admin_id") @db.Uuid

  action String @db.VarChar(80)

  targetType String  @map("target_type") @db.VarChar(40)
  /// Deliberately not a UUID column: a target may be a payout batch, a city id,
  /// or a phone number, and forcing them all into one type would mean inventing
  /// surrogate ids for the sake of the audit table.
  targetId   String? @map("target_id") @db.VarChar(120)

  /// The substance of the decision — before/after, the note, the amount. An
  /// audit row that records only "somebody clicked fail" is not evidence.
  payload Json @db.JsonB

  ip        String? @db.VarChar(64)
  /// Ties the row back to the request log, so an incident review can read the
  /// whole HTTP exchange around a decision.
  requestId String? @map("request_id") @db.VarChar(140)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor      User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAdmin AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId, createdAt])
  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------
//
// Everything the system did in Phases 1–9 happened silently. A booking request a
// mistri never heard about expired; a suspension nobody explained lost a
// technician forever; a cash payment the customer was never told about was an
// invitation to fraud. These two tables are retention and fraud-sunlight
// infrastructure, not a texting feature.

/// Where a message goes.
///
/// `in_app` is always on and costs nothing — it is a row in this database, and
/// the inbox is the only channel that can hold a long message. `whatsapp` is the
/// primary external channel: cheap, rich, and outside the DLT regime. `sms` is
/// reserved for the handful of things a person must find out even with no data
/// connection, because every SMS costs money and needs a registered DLT template.
enum NotificationChannel {
  in_app
  whatsapp
  sms

  @@map("notification_channel")
}

/// How much the message is allowed to interrupt somebody.
///
/// `critical` reaches a person at 3am: an OTP they are waiting on, a job that was
/// just cancelled, a suspension, or cash recorded against their name. `standard`
/// waits for the quiet-hours window to open. Nothing is ever dropped for being
/// standard — it is delayed, which is a different promise.
enum NotificationCriticality {
  critical
  standard

  @@map("notification_criticality")
}

enum NotificationDeliveryStatus {
  queued
  sent
  failed
  /// Held back by quiet hours. `scheduled_for` says when the release job sends
  /// it, and it becomes `sent` then — the row records that the delay happened.
  suppressed_quiet_hours

  @@map("notification_delivery_status")
}

/// The in-app inbox: one row per person per thing that happened to them.
///
/// The **rendered text is deliberately not stored** — only the template keys and
/// their parameters. That way a person who switches to English sees their whole
/// history in English, and a corrected wording fixes every past message rather
/// than only future ones.
model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  topic       String @db.VarChar(120)
  /// The booking, provider or complaint this is about. Half the idempotency key.
  aggregateId String @map("aggregate_id") @db.Uuid

  titleKey String @map("title_key") @db.VarChar(160)
  bodyKey  String @map("body_key") @db.VarChar(160)
  /// Typed parameters for the template. Validated against the template's
  /// declared parameter list before anything is written — a missing one is a
  /// test failure, never `undefined` in a customer's WhatsApp.
  params   Json   @db.JsonB

  /// A route hint for the apps, e.g. `booking/{id}`. Groundwork for push
  /// notifications in Phase 14; nothing consumes it yet.
  deepLink String? @map("deep_link") @db.VarChar(200)

  criticality NotificationCriticality

  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// One attempt to put a notification in front of a person, per channel.
///
/// ## Why the idempotency key lives here
///
/// The outbox is at-least-once by design, so every consumer will be called twice
/// eventually. For a projection that is harmless — recompute and get the same
/// number. For a message it is not: the human sees it twice, and after the third
/// identical WhatsApp about the same booking they stop reading any of them.
///
/// `(topic, aggregate_id, recipient_user_id, channel)` is unique, so a redelivery
/// loses the insert instead of messaging somebody again. The three leading
/// columns are denormalised copies of what the notification and its triggering
/// event already know — the constraint has to live on the row it constrains.
model NotificationDelivery {
  id             String @id @default(uuid()) @db.Uuid
  notificationId String @map("notification_id") @db.Uuid

  topic           String @db.VarChar(120)
  aggregateId     String @map("aggregate_id") @db.Uuid
  recipientUserId String @map("recipient_user_id") @db.Uuid

  channel   NotificationChannel
  /// Which implementation actually handled it — `fake`, `console`, `msg91`,
  /// `whatsapp_cloud`, `in_app`. Recorded so a delivery dispute can be answered.
  transport String              @db.VarChar(40)

  status       NotificationDeliveryStatus @default(queued)
  /// Provider-side message id, for chasing a "it never arrived" with the vendor.
  transportRef String?                    @map("transport_ref") @db.VarChar(200)
  attempts     Int                        @default(0)
  lastError    String?                    @map("last_error") @db.VarChar(1000)
  /// When quiet hours end, for anything held back. Null for everything else.
  scheduledFor DateTime?                  @map("scheduled_for") @db.Timestamptz(3)
  sentAt       DateTime?                  @map("sent_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([topic, aggregateId, recipientUserId, channel])
  @@index([status, scheduledFor])
  @@index([notificationId])
  @@map("notification_deliveries")
}
