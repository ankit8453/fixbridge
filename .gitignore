# dependencies
node_modules/
.npm/

# build output
dist/
build/
*.tsbuildinfo

# environment — .env.example is committed, real .env files are never committed
.env
.env.*
!.env.example

# test / coverage
coverage/
.vitest/
*.lcov

# logs
logs/
*.log
npm-debug.log*

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local docker volumes / scratch
.docker-data/
tmp/

# Built APKs staged for the download page.
#
# Binaries, ~120 MB each as debug builds, and rebuilt on every release — git is
# the wrong place for them. The host serves this directory; the README beside
# them says what has to be true of a real release build.
apps/web/public/downloads/*.apk
